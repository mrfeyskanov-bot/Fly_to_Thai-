{
  "name": "Fly to Thai",
  "version": "1.0.0",
  "description": "Туроператор по Таиланду - профессиональные туры и путевки",
  "author": "Your Name",
  "authorURL": "https://example.com",
  "themeURI": "https://example.com/themes/fly-to-thai",
  "textDomain": "fly-to-thai",
  "domainPath": "/languages",
  "requiresWP": "5.0",
  "requiresPHP": "7.4",
  "license": "GPL-2.0-or-later",
  "licenseURI": "https://www.gnu.org/licenses/gpl-2.0.html",
  "features": [
    "responsive-layout",
    "custom-logo",
    "post-thumbnails",
    "menus",
    "widgets",
    "internationalization"
  ],
  "customPostTypes": [
    {
      "name": "tour",
      "label": "Туры",
      "icon": "dashicons-palmtree"
    },
    {
      "name": "review",
      "label": "Отзывы",
      "icon": "dashicons-testimonial"
    },
    {
      "name": "expert",
      "label": "Специалисты",
      "icon": "dashicons-businessperson"
    }
  ],
  "customTaxonomies": [
    {
      "name": "tour_direction",
      "label": "Направления",
      "postTypes": ["tour"]
    },
    {
      "name": "tour_level",
      "label": "Уровни сложности",
      "postTypes": ["tour"]
    }
  ],
  "sidebars": [
    {
      "id": "primary-sidebar",
      "name": "Основная боковая колонка"
    },
    {
      "id": "footer-1",
      "name": "Подвал 1"
    },
    {
      "id": "footer-2",
      "name": "Подвал 2"
    },
    {
      "id": "footer-3",
      "name": "Подвал 3"
    }
  ],
  "dependencies": {
    "bootstrap": "5.3.0",
    "fontAwesome": "6.4.0",
    "jquery": "included"
  },
  "scripts": [
    "main.js",
    "form-validation.js",
    "animations.js"
  ],
  "styles": [
    "custom.css",
    "animations.css"
  ]
}
